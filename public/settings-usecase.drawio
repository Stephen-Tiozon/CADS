<mxfile host="app.diagrams.net">
  <diagram name="CADS Settings Use Case">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- System Boundary Box -->
        <mxCell id="sys_box" value="CADS: Settings &amp;amp; Configuration Subsystem" style="shape=rect;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontStyle=1;fontSize=15;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="210" y="35" width="670" height="755" as="geometry" />
        </mxCell>

        <!-- Stickman Actor: Social Worker (Left) -->
        <mxCell id="actor_sw" value="Social Worker&#xa;(Staff User)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=14;strokeColor=#0f172a;strokeWidth=2;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="70" y="280" width="45" height="90" as="geometry" />
        </mxCell>

        <!-- Stickman Actor: Admin (Right) -->
        <mxCell id="actor_admin" value="Admin&#xa;(System Administrator)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=14;strokeColor=#0f172a;strokeWidth=2;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="960" y="460" width="45" height="90" as="geometry" />
        </mxCell>

        <!-- Profile Management (Shared) -->
        <mxCell id="uc_profile" value="Manage Profile Information" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;strokeColor=#2563eb;strokeWidth=2;fillColor=#eff6ff;" vertex="1" parent="1">
          <mxGeometry x="320" y="80" width="200" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_avatar" value="Upload &amp;amp; Crop Avatar Picture" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="580" y="80" width="210" height="55" as="geometry" />
        </mxCell>

        <!-- Notification Preferences -->
        <mxCell id="uc_notif" value="Configure Notification Alerts&#xa;(Assessments &amp;amp; SLA Reminders)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="320" y="170" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- Account Security -->
        <mxCell id="uc_security" value="Manage Account Security&#xa;&amp;amp; Change Password" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.8;fillColor=#eff6ff;" vertex="1" parent="1">
          <mxGeometry x="320" y="260" width="210" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_verify_pwd" value="Verify Current Password" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="580" y="262" width="190" height="50" as="geometry" />
        </mxCell>

        <!-- UI Appearance Preferences -->
        <mxCell id="uc_theme" value="Customize UI Theme&#xa;(Light / Dark / System Mode)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#0f172a;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="320" y="350" width="210" height="55" as="geometry" />
        </mxCell>

        <!-- Admin Only: Question Banks -->
        <mxCell id="uc_tuner" value="Manage Assessment&#xa;Question Banks" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;strokeColor=#000000;strokeWidth=2;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="450" y="490" width="230" height="65" as="geometry" />
        </mxCell>

        <!-- Audit Configuration Changes -->
        <mxCell id="uc_audit" value="Audit Configuration &amp;amp;&#xa;System Changes" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#000000;strokeWidth=1.8;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="460" y="615" width="210" height="55" as="geometry" />
        </mxCell>

        <!-- ================= ACTOR ASSOCIATIONS ================= -->
        <!-- Social Worker Associations (Personal Settings) -->
        <mxCell id="edge_sw_prof" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_sw" target="uc_profile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_sw_notif" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_sw" target="uc_notif">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_sw_sec" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_sw" target="uc_security">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_sw_theme" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_sw" target="uc_theme">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Admin Associations (Personal Settings + Administrative System Control) -->
        <mxCell id="edge_admin_prof" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_admin" target="uc_profile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_admin_theme" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_admin" target="uc_theme">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_admin_tuner" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_admin" target="uc_tuner">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_admin_audit" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_admin" target="uc_audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= INCLUDE RELATIONSHIPS ================= -->
        <mxCell id="inc_avatar" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="dashed=1;endArrow=open;endSize=8;html=1;strokeWidth=1.2;strokeColor=#64748b;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc_profile" target="uc_avatar">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc_verify" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="dashed=1;endArrow=open;endSize=8;html=1;strokeWidth=1.2;strokeColor=#64748b;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc_security" target="uc_verify_pwd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc_tuner_audit" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="dashed=1;endArrow=open;endSize=8;html=1;strokeWidth=1.2;strokeColor=#64748b;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="uc_tuner" target="uc_audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

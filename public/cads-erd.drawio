        <mxCell id="oi_r5_c2" value="scoring_scale : VARCHAR(50)" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;fontSize=9;" vertex="1" parent="oi_r5"><mxGeometry x="28" width="237" height="18" as="geometry" /></mxCell>


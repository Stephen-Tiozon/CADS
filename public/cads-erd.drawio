        <!-- ===== BOX: SPECIFICATION & METRICS ===== -->
        <mxCell id="box_specs" value="REVISED CADS SPECIFICATIONS" style="swimlane;startSize=20;fontStyle=1;fontSize=10;strokeColor=#000000;strokeWidth=1.2;fillColor=#000000;fontColor=#ffffff;collapsible=0;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="885" y="534" width="265" height="174" as="geometry" />
        </mxCell>
        <mxCell id="spec_desc" value="• System Scope: Assessment, scoring, records &amp; reports only.&#xa;• Out-of-Scope Removed: risk_index, disposition plans &amp; updates, auto-interventions.&#xa;• Psychometric Instruments:&#xa;  1. LMD: 14 open-ended dilemmas, mean &amp; scaled.&#xa;  2. IVJ: 54 binary items, raw &amp; scaled.&#xa;  3. CFC: 35 child functioning checklist items.&#xa;  4. FFC: 28 family functioning checklist items.&#xa;• Combined Discernment: Mean of LMD &amp; IVJ scaled scores.&#xa;• Database Engine: MySQL / MariaDB (InnoDB, 3NF).&#xa;• Foreign Key Integrity: No blanket cascade delete on cases with assessments." style="text;html=1;align=left;verticalAlign=top;fontSize=8.5;fontColor=#000000;spacingLeft=4;fillColor=#ffffff;rounded=0;" vertex="1" parent="box_specs">
          <mxGeometry y="20" width="265" height="154" as="geometry" />
        </mxCell>


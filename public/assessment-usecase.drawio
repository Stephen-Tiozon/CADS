        <!-- Admin Associations -->
        <mxCell id="edge_admin_view" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_admin" target="uc_view">
          <mxGeometry relative="1" as="geometry" />

<mxfile host="app.diagrams.net">
  <diagram name="CADS Assessment Use Case">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- System Boundary Box -->
        <mxCell id="sys_box" value="CADS: Assessment Subsystem" style="shape=rect;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontStyle=1;fontSize=15;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="210" y="40" width="670" height="740" as="geometry" />
        </mxCell>

        <!-- Stickman Actor: Social Worker (Left) -->
        <mxCell id="actor_sw" value="Social Worker&#xa;(Case Assessor)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=14;strokeColor=#0f172a;strokeWidth=2;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="70" y="290" width="45" height="90" as="geometry" />
        </mxCell>

        <!-- Stickman Actor: Admin (Right) -->
        <mxCell id="actor_admin" value="Admin&#xa;(System Supervisor)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=14;strokeColor=#0f172a;strokeWidth=2;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="960" y="470" width="45" height="90" as="geometry" />
        </mxCell>

        <!-- Core Hub Use Case -->
        <mxCell id="uc_assess" value="Conduct Case Assessment" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;strokeColor=#2563eb;strokeWidth=2;fillColor=#eff6ff;" vertex="1" parent="1">
          <mxGeometry x="250" y="160" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- Included Assessment Instruments -->
        <mxCell id="uc_lmd" value="Administer LMD Tool&#xa;(Moral Development / Discernment)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="540" y="70" width="210" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_ivj" value="Administer IVJ Tool&#xa;(Individual Vulnerability Factors)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="540" y="135" width="210" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_cfc" value="Administer CFC Tool&#xa;(Community Factor Checklist)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="540" y="200" width="210" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_ffc" value="Administer FFC Tool&#xa;(Family Factor Checklist)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="540" y="265" width="210" height="55" as="geometry" />
        </mxCell>

        <!-- Scoring & Diversion -->
        <mxCell id="uc_score" value="Calculate Discernment&#xa;&amp;amp; Risk Scores" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="540" y="340" width="210" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_recommend" value="Generate Diversion&#xa;Recommendation" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="540" y="415" width="210" height="55" as="geometry" />
        </mxCell>

        <!-- Results & Reporting -->
        <mxCell id="uc_view" value="View Assessment Results" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;strokeColor=#0f172a;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="300" y="480" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_export" value="Export Assessment&#xa;Report (PDF)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#0f172a;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="550" y="500" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- Admin Specific Use Cases -->
        <mxCell id="uc_config" value="Configure Assessment&#xa;Tools &amp;amp; Questions" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;strokeColor=#dc2626;strokeWidth=1.8;fillColor=#fef2f2;" vertex="1" parent="1">
          <mxGeometry x="490" y="640" width="230" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc_audit" value="Audit Assessment&#xa;Activity Logs" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#0f172a;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="270" y="645" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- ================= ACTOR ASSOCIATIONS ================= -->
        <!-- Social Worker Associations -->
        <mxCell id="edge_sw_assess" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_sw" target="uc_assess">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_sw_view" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_sw" target="uc_view">
          <mxGeometry relative="1" as="geometry" />

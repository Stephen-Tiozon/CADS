        <mxCell id="edge_admin_config" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_admin" target="uc_config">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= INCLUDE RELATIONSHIPS ================= -->
        <mxCell id="inc_lmd" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="dashed=1;endArrow=open;endSize=8;html=1;strokeWidth=1.2;strokeColor=#64748b;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc_assess" target="uc_lmd">
          <mxGeometry relative="1" as="geometry" />

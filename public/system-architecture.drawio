          <mxGeometry x="20" y="52" width="150" height="126" as="geometry" />
        </mxCell>

        <mxCell id="db_tbl2" value="&lt;b&gt;Assessments &amp; Tools&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;assessments&lt;/b&gt; (scores)&lt;br&gt;• &lt;b&gt;assessment_answers&lt;/b&gt;&lt;br&gt;• &lt;b&gt;lmd_question_bank&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ivj_question_bank&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;Raw &amp; scaled separation&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#000000;strokeWidth=0.8;fontSize=7.5;align=left;spacingLeft=5;lineHeight=1.2;" vertex="1" parent="tier_data">
          <mxGeometry x="176" y="52" width="154" height="126" as="geometry" />
        </mxCell>

        <mxCell id="db_tbl3" value="&lt;b&gt;Notes, Files &amp; Audit&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;case_notes&lt;/b&gt;&lt;br&gt;• &lt;b&gt;case_files&lt;/b&gt; (FK user_id)&lt;br&gt;• &lt;b&gt;audit_logs&lt;/b&gt; (immutable)&lt;br&gt;&lt;br&gt;&lt;i&gt;Complete auditability&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#000000;strokeWidth=0.8;fontSize=7.5;align=left;spacingLeft=5;lineHeight=1.2;" vertex="1" parent="tier_data">
          <mxGeometry x="336" y="52" width="154" height="126" as="geometry" />
        </mxCell>

        <!-- Cloud File Storage Box -->
        <mxCell id="fs_box" value="SECURED CLOUD STORAGE&#xa;(/uploads/case_files/)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=8.5;align=center;verticalAlign=top;" vertex="1" parent="tier_data">
          <mxGeometry x="508" y="26" width="155" height="162" as="geometry" />
        </mxCell>
        <mxCell id="fs_sub1" value="&lt;b&gt;Case Attachments&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Birth Certificates&lt;br&gt;• Police / Blotter Extracts&lt;br&gt;• Legal &amp; Medical Reports&lt;br&gt;• Exported Case Study PDFs&lt;br&gt;&lt;br&gt;&lt;i&gt;Execution-disabled (.htaccess/Nginx), MIME validation, authenticated streaming&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#000000;strokeWidth=0.8;fontSize=7.5;align=left;spacingLeft=5;lineHeight=1.2;" vertex="1" parent="tier_data">
          <mxGeometry x="516" y="52" width="139" height="126" as="geometry" />
        </mxCell>

        <!-- ======================================================== -->
        <!-- TIER 5: SECURITY, AUDIT & COMPLIANCE                     -->
        <!-- ======================================================== -->
        <mxCell id="tier_sec" value="  5. SECURITY, AUDIT &amp; CLOUD HARDENING" style="swimlane;startSize=22;fontStyle=1;fontSize=10;strokeColor=#000000;strokeWidth=1.5;fillColor=#f8fafc;fontColor=#000000;collapsible=0;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="562" width="434" height="198" as="geometry" />
        </mxCell>

        <mxCell id="sec1" value="&lt;b&gt;Role-Based Access Control (RBAC) &amp; Session Hardening&lt;/b&gt;&lt;br&gt;Strict separation of Social Worker (assessor) and Administrator (head); protected route guards; HttpOnly &amp; SameSite=Strict cookies; server-side session authentication." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=7.5;align=left;spacingLeft=6;lineHeight=1.2;" vertex="1" parent="tier_sec">
          <mxGeometry x="12" y="28" width="410" height="36" as="geometry" />
        </mxCell>

        <mxCell id="sec2" value="&lt;b&gt;Transport Security &amp; Cryptographic Protection&lt;/b&gt;&lt;br&gt;End-to-end TLS 1.3 / HTTPS encryption in transit; salted Bcrypt hashing via PHP password_hash(); 100% PDO parameterized prepared statements preventing SQL Injection." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=7.5;align=left;spacingLeft=6;lineHeight=1.2;" vertex="1" parent="tier_sec">
          <mxGeometry x="12" y="69" width="410" height="36" as="geometry" />
        </mxCell>

        <mxCell id="sec3" value="&lt;b&gt;Tamper-Evident System Audit Trail &amp; Network Defense&lt;/b&gt;&lt;br&gt;Immutable activity logs with actor user ID, client IP address, action, and timestamp; Cloud Firewall &amp; rate-limiting mitigating unauthorized online access." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=7.5;align=left;spacingLeft=6;lineHeight=1.2;" vertex="1" parent="tier_sec">
          <mxGeometry x="12" y="110" width="410" height="36" as="geometry" />
        </mxCell>

        <mxCell id="sec4" value="&lt;b&gt;RA 9344 &amp; RA 10173 Juvenile Justice &amp; Data Privacy Compliance&lt;/b&gt;&lt;br&gt;Minors' identity confidentiality; strictly zero client-side caching of CICL personal data; restricted deletion to safeguard legal assessment integrity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontSize=7.5;align=left;spacingLeft=6;lineHeight=1.2;" vertex="1" parent="tier_sec">
          <mxGeometry x="12" y="151" width="410" height="36" as="geometry" />
        </mxCell>


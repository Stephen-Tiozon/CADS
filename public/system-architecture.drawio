        <!-- App Tier to Security & Compliance -->
        <mxCell id="flow_app_sec" value="" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;startArrow=classic;exitX=0.82;exitY=1;entryX=0.5;entryY=0;" edge="1" source="tier_app" target="tier_sec" parent="1">

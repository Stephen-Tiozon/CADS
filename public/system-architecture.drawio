        <!-- Core Business & Scoring Engines Section (Right - 2x2 Clean Grid) -->
        <mxCell id="app_eng_box" value="RULE-BASED ASSESSMENT SCORING &amp; INTERPRETATION ENGINES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontStyle=1;fontSize=9;align=center;verticalAlign=top;" vertex="1" parent="tier_app">
          <mxGeometry x="672" y="26" width="435" height="172" as="geometry" />
        </mxCell>

        <!-- Engine 1 (Top Left) -->
        <mxCell id="eng1" value="&lt;b&gt;LMD Moral Development Engine&lt;/b&gt;&lt;br&gt;• 14 Kohlberg Heinz Dilemmas ($s_i \in [1, 6]$)&lt;br&gt;• Mean Dilemma Stage: $M_{\mathrm{LMD}} = \sum s_i / 14$&lt;br&gt;• Bracket Mapping $\rightarrow$ Scaled Score $S_{\mathrm{LMD}} \in [1, 6]$&lt;br&gt;• Pre-, Conventional, Post-conventional stages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#000000;strokeWidth=0.8;fontSize=7.5;align=left;spacingLeft=5;lineHeight=1.2;" vertex="1" parent="tier_app">
          <mxGeometry x="682" y="44" width="205" height="66" as="geometry" />
        </mxCell>

        <!-- Engine 2 (Top Right) -->
        <mxCell id="eng2" value="&lt;b&gt;IVJ Value Judgment Engine&lt;/b&gt;&lt;br&gt;• 54 Binary Correctness Items ($c_j \in \{0, 1\}$)&lt;br&gt;• Raw Correct Score: $R_{\mathrm{IVJ}} = \sum c_j$ (0–54)&lt;br&gt;• Interval Brackets $\rightarrow$ Scaled Score $S_{\mathrm{IVJ}} \in [1, 6]$&lt;br&gt;• Qualitative Value Judgment Classification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#000000;strokeWidth=0.8;fontSize=7.5;align=left;spacingLeft=5;lineHeight=1.2;" vertex="1" parent="tier_app">
          <mxGeometry x="893" y="44" width="204" height="66" as="geometry" />
        </mxCell>

        <!-- Engine 3 (Bottom Left) -->
        <mxCell id="eng3" value="&lt;b&gt;Combined Discernment Engine&lt;/b&gt;&lt;br&gt;• Arithmetic Mean: $D = (S_{\mathrm{LMD}} + S_{\mathrm{IVJ}}) / 2$&lt;br&gt;• Qualitative Discernment Interpretation Level&lt;br&gt;• Clinical aid for Social Worker evaluation&lt;br&gt;• &lt;i&gt;Zero automated statutory legal determinations&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#000000;strokeWidth=0.8;fontSize=7.5;align=left;spacingLeft=5;lineHeight=1.2;" vertex="1" parent="tier_app">
          <mxGeometry x="682" y="118" width="205" height="66" as="geometry" />
        </mxCell>

        <!-- Engine 4 (Bottom Right) -->
        <mxCell id="eng4" value="&lt;b&gt;CFC &amp; FFC Functioning Engines&lt;/b&gt;&lt;br&gt;• Child (35 items) &amp; Family (28 items) Checklists&lt;br&gt;• Independent weighted means (Sum / Applicable)&lt;br&gt;• Guarded against division-by-zero ($n_{\mathrm{app}} &gt; 0$)&lt;br&gt;• &lt;i&gt;Independent profiles; never merged into CRI&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#000000;strokeWidth=0.8;fontSize=7.5;align=left;spacingLeft=5;lineHeight=1.2;" vertex="1" parent="tier_app">

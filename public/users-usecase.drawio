<mxfile host="app.diagrams.net">
  <diagram name="CADS Users Use Case">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- System Boundary Box -->
        <mxCell id="sys_box" value="CADS: User Management Subsystem" style="shape=rect;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontStyle=1;fontSize=15;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="210" y="35" width="670" height="755" as="geometry" />
        </mxCell>

        <!-- Stickman Actor: Social Worker (Left) -->
        <mxCell id="actor_sw" value="Social Worker&#xa;(Staff User)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=14;strokeColor=#0f172a;strokeWidth=2;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="70" y="470" width="45" height="90" as="geometry" />
        </mxCell>

        <!-- Stickman Actor: Admin (Right) -->
        <mxCell id="actor_admin" value="Admin&#xa;(System Administrator)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=14;strokeColor=#0f172a;strokeWidth=2;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="960" y="240" width="45" height="90" as="geometry" />
        </mxCell>

        <!-- Admin Core: Directory & Creation -->
        <mxCell id="uc_create" value="Create New User Account" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.8;fillColor=#eff6ff;" vertex="1" parent="1">
          <mxGeometry x="480" y="65" width="210" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_dir" value="View User Accounts Directory" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;strokeColor=#2563eb;strokeWidth=2;fillColor=#eff6ff;" vertex="1" parent="1">
          <mxGeometry x="480" y="145" width="210" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_role" value="Assign Roles &amp;amp; Access Level&#xa;(Admin / Social Worker)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="480" y="235" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_edit" value="Update User Details &amp;amp;&#xa;Reset Account Password" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="480" y="315" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_delete" value="Deactivate / Delete&#xa;User Account" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#dc2626;strokeWidth=1.8;fillColor=#fef2f2;" vertex="1" parent="1">
          <mxGeometry x="480" y="395" width="210" height="55" as="geometry" />
        </mxCell>

        <!-- Access Control & Security -->
        <mxCell id="uc_rbac" value="Enforce Role-Based&#xa;Access Control (RBAC)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#0f172a;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="480" y="475" width="210" height="55" as="geometry" />
        </mxCell>

        <!-- Social Worker / Personal Account Management -->
        <mxCell id="uc_profile" value="View Own Profile&#xa;Information" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;strokeColor=#2563eb;strokeWidth=2;fillColor=#eff6ff;" vertex="1" parent="1">
          <mxGeometry x="240" y="460" width="190" height="65" as="geometry" />
        </mxCell>

        <mxCell id="uc_update_self" value="Update Own Profile&#xa;&amp;amp; Contact Details" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="240" y="555" width="190" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_pwd_self" value="Change Own Account&#xa;Password" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="240" y="640" width="190" height="55" as="geometry" />
        </mxCell>

        <!-- Audit Logging -->
        <mxCell id="uc_audit" value="Audit User Management&#xa;&amp;amp; Security Events" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#dc2626;strokeWidth=1.8;fillColor=#fef2f2;" vertex="1" parent="1">
          <mxGeometry x="540" y="640" width="210" height="55" as="geometry" />
        </mxCell>

        <!-- ================= ACTOR ASSOCIATIONS ================= -->
        <!-- Admin Associations (Full User Management Privileges) -->
        <mxCell id="edge_admin_create" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_admin" target="uc_create">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_admin_dir" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_admin" target="uc_dir">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_admin_edit" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_admin" target="uc_edit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_admin_del" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_admin" target="uc_delete">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Social Worker Associations (Self Management Only) -->
        <mxCell id="edge_sw_prof" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_sw" target="uc_profile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_sw_update" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_sw" target="uc_update_self">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_sw_pwd" style="endArrow=none;html=1;strokeWidth=1.6;strokeColor=#334155;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="actor_sw" target="uc_pwd_self">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= INCLUDE RELATIONSHIPS ================= -->
        <mxCell id="inc_role" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="dashed=1;endArrow=open;endSize=8;html=1;strokeWidth=1.2;strokeColor=#64748b;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc_create" target="uc_role">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc_rbac" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="dashed=1;endArrow=open;endSize=8;html=1;strokeWidth=1.2;strokeColor=#64748b;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc_dir" target="uc_rbac">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc_audit_create" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="dashed=1;endArrow=open;endSize=8;html=1;strokeWidth=1.2;strokeColor=#64748b;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc_delete" target="uc_audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inc_audit_edit" value="&amp;lt;&amp;lt;include&amp;gt;&amp;gt;" style="dashed=1;endArrow=open;endSize=8;html=1;strokeWidth=1.2;strokeColor=#64748b;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc_edit" target="uc_audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ================= EXTEND RELATIONSHIP ================= -->
        <mxCell id="ext_pwd" value="&amp;lt;&amp;lt;extend&amp;gt;&amp;gt;" style="dashed=1;endArrow=open;endSize=8;html=1;strokeWidth=1.2;strokeColor=#64748b;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="uc_pwd_self" target="uc_profile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

<mxfile host="app.diagrams.net">
  <diagram name="CADS Reports Use Case">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- System Boundary Box -->
        <mxCell id="sys_box" value="CADS: Reports &amp;amp; Analytics Subsystem" style="shape=rect;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontStyle=1;fontSize=15;fillColor=#f8fafc;strokeColor=#0f172a;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="220" y="40" width="660" height="740" as="geometry" />
        </mxCell>

        <!-- Stickman Actor: Social Worker (Left) -->
        <mxCell id="actor_sw" value="Social Worker&#xa;(Report Preparer)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=14;strokeColor=#0f172a;strokeWidth=2;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="70" y="280" width="45" height="90" as="geometry" />
        </mxCell>

        <!-- Stickman Actor: Admin (Right) -->
        <mxCell id="actor_admin" value="Admin&#xa;(MSWDO Supervisor)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=14;strokeColor=#0f172a;strokeWidth=2;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="960" y="460" width="45" height="90" as="geometry" />
        </mxCell>

        <!-- Core Hub Use Case -->
        <mxCell id="uc_hub" value="View System Analytics&#xa;&amp;amp; Case Reports" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;strokeColor=#2563eb;strokeWidth=2;fillColor=#eff6ff;" vertex="1" parent="1">
          <mxGeometry x="250" y="160" width="190" height="65" as="geometry" />
        </mxCell>

        <!-- Sub Use Cases (Included Analytical Operations) -->
        <mxCell id="uc_filter" value="Filter Reports by Period&#xa;(All-Time / Fiscal Year / Monthly)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="540" y="70" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_caseload" value="Generate Aggregate&#xa;Caseload Summary" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="540" y="140" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_discernment" value="Generate Discernment &amp;amp;&#xa;Risk Factor Analytics" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="540" y="210" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_trend" value="Generate Monthly Intake&#xa;Volume Trends" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="540" y="280" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="uc_registry" value="Generate Active Caseload&#xa;Registry Table" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#2563eb;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="540" y="350" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- Export & PDF Generation -->
        <mxCell id="uc_export" value="Export Official Report&#xa;to PDF / Print" style="ellipse;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;strokeColor=#0f172a;strokeWidth=2;fillColor=#f1f5f9;" vertex="1" parent="1">
          <mxGeometry x="310" y="470" width="190" height="60" as="geometry" />
        </mxCell>

        <!-- Signatures and Endorsement -->
        <mxCell id="uc_endorse" value="Sign &amp;amp; Endorse MSWDO&#xa;Official Submission" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#0f172a;strokeWidth=1.5;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="560" y="520" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- Audit & Compliance -->
        <mxCell id="uc_audit" value="Audit Report Generation&#xa;&amp;amp; Download Logs" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;strokeColor=#dc2626;strokeWidth=1.8;fillColor=#fef2f2;" vertex="1" parent="1">
          <mxGeometry x="460" y="650" width="210" height="55" as="geometry" />
